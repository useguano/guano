{
  "name": "guano-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/useguano/guano#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/useguano/guano.git"
  },
  "bugs": {
    "url": "https://github.com/useguano/guano/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "serve": "node server/index.mjs",
    "build-only": "vite build",
    "build:mcp-runtime": "vite build --config vite.mcp.config.ts",
    "build:motion": "vite build --config vite.motion.config.ts",
    "build:slider": "vite build --config vite.slider.config.ts",
    "build:icons": "npx -y tsx --tsconfig tsconfig.app.json scripts/build-icons.ts",
    "type-check": "vue-tsc --build",
    "check:mcp": "node scripts/measure-mcp.mjs",
    "check:corpus": "node scripts/corpus.mjs check",
    "check:html": "npx -y tsx --tsconfig tsconfig.app.json scripts/check-html.ts",
    "check:migrate": "npx -y tsx --tsconfig tsconfig.app.json scripts/check-migrate.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/browser": "^4.3.3",
    "@tailwindcss/node": "^4.3.3",
    "lucide-vue-next": "^1.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.2",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
